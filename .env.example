# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# When running via docker-compose the host should be `db` (the service name).
DATABASE_URL=postgresql://postgres:postgres@db:5432/careerplanner

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-64-char-hex-string

# ─── LinkedIn Jobs API ────────────────────────────────────────────────────────
# OAuth 2.0 application credentials from https://developer.linkedin.com/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Handshake API ────────────────────────────────────────────────────────────
# Campus / partner API key from your Handshake institution account.
HANDSHAKE_API_KEY=

# ─── Indeed Publisher API ─────────────────────────────────────────────────────
# Publisher ID from https://publisher.indeed.com/
INDEED_PUBLISHER_ID=

# ─── USAJobs REST API ─────────────────────────────────────────────────────────
# API key from https://developer.usajobs.gov/
USAJOBS_API_KEY=

# ─── BLS Occupational Employment & Wage Statistics API ───────────────────────
# API key from https://data.bls.gov/registrationEngine/
BLS_API_KEY=
